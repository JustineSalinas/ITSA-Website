rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors firestore.rules: a verified admin claim, not merely being
    // signed in. Firebase Storage rules cannot read Firestore, so the
    // /admins/{uid} document check is not available here — the custom claim
    // is the gate, and revoking it revokes upload access on token refresh.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSafeImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)');
    }

    // Public read for officer photos and event images; admin-only write.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
