rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nothing in this app authenticates as anyone -- the officer admin
    // dashboard, the contact form, and the Ask ITSA tally were all removed,
    // and content now lives in Sanity -- so there is no client read/write
    // path left at all. The Admin SDK (api/health's Firestore check) bypasses
    // these rules entirely.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
